# 이름만 적는다. 실제 값은 Vercel 프로젝트 설정에 넣고 저장소에는 올리지 않는다.

# 공개 값(브라우저 번들에 들어간다)
# production 또는 preview. production일 때만 색인을 허용하고 assertCompany()를 실행한다
NEXT_PUBLIC_SITE_ENV=
# 영상·이미지 주소의 앞부분. 비워 두면 /media
NEXT_PUBLIC_MEDIA_BASE=
# GA4 측정 ID. 비어 있으면 분석 코드를 넣지 않는다
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile 위젯 키
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 구글 서치 콘솔 소유확인 메타 값(DNS TXT 인증이 기본). 비어 있으면 태그를 넣지 않는다
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# 네이버 서치어드바이저 소유확인 메타 값. 비어 있으면 태그를 넣지 않는다
NEXT_PUBLIC_NAVER_VERIFICATION=

# 비공개 값(서버 코드에서만 읽는다. 미리보기 배포에는 운영 값을 넣지 않는다)
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
