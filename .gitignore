# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is committed
!.env.example

# local preview config
.claude/launch.json

# generated before each build
/public/llms.txt

# legal research notes, kept out of the public repository
/docs/private/
# 무료 요금제 사진의 검토용 사본. 로컬 커밋도 하지 않는다
/public/media/preview/
